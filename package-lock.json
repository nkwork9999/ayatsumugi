{
  "name": "ayatsumugi-workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ayatsumugi-workspace",
      "version": "0.1.0",
      "workspaces": [
        "extensions/vscode",
        "packages/sdk",
        "packages/react",
        "packages/terminal"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "extensions/vscode": {
      "name": "ayatsumugi-vscode",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "engines": {
        "node": ">=20",
        "vscode": "^1.90.0"
      }
    },
    "node_modules/@noobknotsdev/ayatsumugi-react": {
      "resolved": "packages/react",
      "link": true
    },
    "node_modules/@noobknotsdev/ayatsumugi-sdk": {
      "resolved": "packages/sdk",
      "link": true
    },
    "node_modules/@noobknotsdev/ayatsumugi-terminal": {
      "resolved": "packages/terminal",
      "link": true
    },
    "node_modules/ayatsumugi-vscode": {
      "resolved": "extensions/vscode",
      "link": true
    },
    "packages/react": {
      "name": "@noobknotsdev/ayatsumugi-react",
      "version": "0.1.1",
      "license": "Apache-2.0",
      "peerDependencies": {
        "react": ">=18"
      },
      "peerDependenciesMeta": {
        "react": {
          "optional": true
        }
      }
    },
    "packages/sdk": {
      "name": "@noobknotsdev/ayatsumugi-sdk",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "engines": {
        "node": ">=20"
      }
    },
    "packages/terminal": {
      "name": "@noobknotsdev/ayatsumugi-terminal",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "bin": {
        "ayatsumugi": "src/cli.mjs",
        "ayatsumugi-terminal": "src/cli.mjs"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
