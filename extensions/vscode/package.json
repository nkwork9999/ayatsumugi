{
  "name": "ayatsumugi-vscode",
  "displayName": "Ayatsumugi",
  "description": "Unified React DOM, state, query, and mutation visualization",
  "version": "0.1.0",
  "publisher": "noobknotsdev",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/nkwork9999/ayatsumugi.git" },
  "homepage": "https://github.com/nkwork9999/ayatsumugi#readme",
  "bugs": "https://github.com/nkwork9999/ayatsumugi/issues",
  "files": [
    "LICENSE",
    "README.md",
    "media",
    "src"
  ],
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": ["Visualization", "Linters"],
  "activationEvents": [
    "onView:ayatsumugi.sidebar",
    "onCommand:ayatsumugi.open",
    "onCommand:ayatsumugi.refresh"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      { "command": "ayatsumugi.open", "title": "Ayatsumugi: Open Unified View" },
      { "command": "ayatsumugi.refresh", "title": "Ayatsumugi: Refresh Both Cores" }
    ],
    "configuration": {
      "title": "Ayatsumugi",
      "properties": {
        "ayatsumugi.language": {
          "type": "string",
          "enum": ["en", "ja"],
          "default": "en",
          "description": "Display language / 表示言語"
        },
        "ayatsumugi.sidecarPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the separately licensed ayatsumugi-mcp executable"
        },
        "ayatsumugi.ayatoriInputPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to an Ayatori runtime trace (.jsonl)"
        },
        "ayatsumugi.tsumugiInputPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a Tsumugi snapshot (.json)"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        { "id": "ayatsumugi", "title": "Ayatsumugi", "icon": "media/ayatsumugi.svg" }
      ]
    },
    "views": {
      "ayatsumugi": [
        { "type": "webview", "id": "ayatsumugi.sidebar", "name": "Runtime Map" }
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
