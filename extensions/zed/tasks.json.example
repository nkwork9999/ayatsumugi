[
  {
    "label": "Ayatsumugi: Open unified report",
    "command": "ayatsumugi-mcp snapshot --source ayatori --input '$ZED_FILE' --format ayatsumugi-v1",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Ayatsumugi: Sidecar version",
    "command": "ayatsumugi-mcp version --json",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  }
]
